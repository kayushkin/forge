[Unit]
Description=Forge API server
After=network.target

[Service]
Type=simple
# The port lives HERE and nowhere else. deploy.sh parses it back out of this
# ExecStart rather than restating it, so the two cannot drift apart.
ExecStart=%h/bin/forge api --port 8150
WorkingDirectory=%h
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
